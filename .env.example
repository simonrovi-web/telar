# Telar · motor Qwen 3 / Ollama · copiar a .env (en la carpeta desde donde se ejecuta) y ajustar.
# En GitHub Actions estas variables se definen en el workflow (no hace falta .env).

# ── conexión ──────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama               # Ollama lo ignora; el SDK de OpenAI exige un valor
# Modelo de chat. Escala según hardware:
#   qwen3:4b    → CI en CPU (GitHub Actions, ~7 GB RAM)        ← recomendado en Actions
#   qwen3:8b    → portátil con 16 GB o GPU de 8 GB
#   qwen3:14b   → GPU de 12–16 GB                               ← valor por defecto local
#   qwen3:32b / qwen3:30b-a3b → GPU de 24 GB o más
OLLAMA_MODEL=qwen3:14b
# Embeddings multilingües para la búsqueda semántica (vacío = solo búsqueda léxica FTS5)
OLLAMA_EMBED_MODEL=bge-m3

# ── robustez ──────────────────────────────────────────────────────────
MOTOR_TIMEOUT_S=600                 # por llamada; en CPU un fragmento largo tarda minutos
MOTOR_REINTENTOS=3                  # errores de red, 429 y 5xx, con backoff exponencial
MOTOR_ESPERA_BASE_S=2
MOTOR_REPARACIONES_JSON=2           # veces que se devuelve el error de esquema al modelo

# ── muestreo ──────────────────────────────────────────────────────────
MOTOR_TEMP_EXTRACCION=0.1
MOTOR_TEMP_SINTESIS=0.3
MOTOR_SEMILLA=42
MOTOR_MAX_TOKENS_EXTRACCION=4096
MOTOR_MAX_TOKENS_SINTESIS=2048
MOTOR_MAX_TOKENS_RAZONAMIENTO=4096  # margen extra cuando el razonamiento está encendido

# ── razonamiento de Qwen 3 (reasoning_effort en /v1; "none" lo apaga) ─
MOTOR_ESFUERZO_RAZONAMIENTO=medium  # valor que se envía cuando se enciende
MOTOR_RAZONAR_EXTRACCION=0          # 0 = rápido y determinista (recomendado en CPU)
MOTOR_RAZONAR_AGENTE=0              # 1 = mejor planificación del agente, bastante más lento

# ── salida estructurada ───────────────────────────────────────────────
MOTOR_MODO_JSON=schema              # schema (json_schema) | object (json_object); cae solo a object si Ollama rechaza schema

# ── extracción, almacén y agente ─────────────────────────────────────
MOTOR_FRAGMENTO_CHARS=5000          # tamaño de cada trozo que se envía al extractor
MOTOR_CONFIANZA_MINIMA=0.5
MOTOR_DB=telar.sqlite               # relativo a la carpeta de ejecución
MOTOR_FRAGMENTO_INDICE_CHARS=900    # tamaño de los fragmentos indexados para búsqueda
MOTOR_MAX_PASOS=6
MOTOR_RESULTADOS_BUSQUEDA=6
